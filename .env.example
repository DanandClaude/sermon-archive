# Copy to .env.local for development. Never commit real values.

# Postgres for the app. Local Homebrew Postgres needs no password.
DATABASE_URL=postgres://localhost:5432/sermon_archive

# Separate database used only by `npm test`. The name must end in _test;
# the test setup refuses to touch anything else.
TEST_DATABASE_URL=postgres://localhost:5432/sermon_archive_test

# Public address of this deployment. Emailed sign-in links are built from it, never from a
# request header. Required in production; defaults to http://localhost:3000 in development.
APP_URL=http://localhost:3000

# fake (default) keeps mail, uploads, Drive, YouTube and podcast calls in memory or on local disk.
# real is only honoured when NODE_ENV=production; anywhere else it throws.
ADAPTER_MODE=fake

# Only needed when ADAPTER_MODE=real.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Sermon Archive <archive@example.org>"
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # only for S3-compatible services other than AWS

# --- Filing and backup --------------------------------------------------------------------
# Encrypts the storage credentials saved by the Connections page. `openssl rand -hex 32`.
# Required in production (the app and the worker must have the same value). Development uses a
# fixed insecure key when this is unset.
# SECRETS_KEY=
# Only for ADAPTER_MODE=real: an OAuth client from your Google Cloud project (type: Web
# application). Authorised redirect URI: <APP_URL>/api/connections/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Database backups (worker/src/sermon_worker/backup.py) --------------------------------
# BACKUP_PASSPHRASE=         # encrypts each backup; keep it safe or a backup can't be restored
# BACKUP_HOUR=2              # half past this hour, in TZ
# BACKUP_LOCAL_DIR=          # development only: where backups go when there is no bucket

# --- Audio worker (worker/) ---------------------------------------------------------------
# The worker reads this file too. Its defaults are fine for development.
# WORKER_ID=                 # defaults to this machine's name
# TRANSCRIBER=mlx            # mlx = the Mac's GPU (fast), whisper = CPU (default, runs anywhere), fake = dev only
# MLX_MODEL=mlx-community/whisper-large-v3-turbo   # for TRANSCRIBER=mlx; found in the Hugging Face cache, never downloaded by the worker
# WHISPER_MODEL=large-v3     # for TRANSCRIBER=whisper; download with: worker/run.sh -m sermon_worker.fetch_model large-v3
# WHISPER_MODEL_PATH=        # or point at an already-downloaded model folder
# WHISPER_COMPUTE=int8       # int8 is the practical choice on a CPU
# TRANSCRIBE_SOURCE=original # original (default) or cleaned
# DATA_DIR=                  # local upload storage; defaults to .data/uploads
# ANALYZER=fake              # fake (default in development) writes placeholder titles and summaries; anthropic sends transcript TEXT (never audio) to Claude. Required in production.
# ANTHROPIC_API_KEY=         # needed when ANALYZER=anthropic. Never commit it.
# ANTHROPIC_MODEL=claude-sonnet-5
