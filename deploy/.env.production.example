# Copy this file to `.env` (in the same folder as compose.yaml) and fill it in.
# Keep `.env` private: it holds passwords. Never commit it or paste it into a chat.

# --- Your address ------------------------------------------------------------------------------
# The domain name that points at this server, with no https:// in front.
DOMAIN=archive.example.org

# --- Database and secrets ----------------------------------------------------------------------
# Make each of these up once:  openssl rand -hex 24   and   openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SECRETS_KEY=change-me-64-hex-characters

# --- Where recordings are stored (any S3-style bucket) -----------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
# Only for services other than Amazon, e.g. https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email for sign-in links (any SMTP provider) -----------------------------------------------
SMTP_URL=smtp://user:password@smtp.example.org:587
MAIL_FROM="Sermon Archive <archive@example.org>"

# --- Google (for filing to Drive; an OAuth client of type "Web application") ------------------
# Redirect address to allow:  https://<DOMAIN>/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Titles, summaries and passage checks (optional) -------------------------------------------
# anthropic sends transcript TEXT (never audio) to Claude. Leave the key empty and set
# ANALYZER=fake only for a trial: it writes placeholder titles and summaries and is not allowed
# in production, so the worker will refuse to start.
ANALYZER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Transcription -----------------------------------------------------------------------------
# medium is a good balance on an ordinary server. large-v3 is more accurate and about twice as slow.
WHISPER_MODEL=medium
# 0 = use every processor. Lower it if the server also does other work.
WHISPER_CPU_THREADS=0

# --- Backups -----------------------------------------------------------------------------------
# Encrypts the nightly database backup. Write it down somewhere safe: without it a backup can't be
# restored. Leave empty for unencrypted backups.
BACKUP_PASSPHRASE=
# Hour of the night (0-23, in TZ) for the backup, at half past.
BACKUP_HOUR=2
TZ=America/Chicago

# --- Advanced (leave alone unless INSTALL.md says otherwise) -----------------------------------
# WEB_IMAGE=ghcr.io/danandclaude/sermon-archive-web:latest
# WORKER_IMAGE=ghcr.io/danandclaude/sermon-archive-worker:latest
