{
  "name": "sermon-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker:install": "python3 -m venv worker/.venv && worker/.venv/bin/pip install -e \"worker[dev]\"",
    "worker": "worker/run.sh",
    "worker:once": "worker/run.sh -m sermon_worker --once",
    "worker:test": "cd worker && .venv/bin/python -m pytest",
    "worker:lint": "cd worker && .venv/bin/ruff check src tests && .venv/bin/ruff format --check src tests",
    "worker:install-mlx": "worker/.venv/bin/pip install -e \"worker[dev,mlx]\"",
    "build:scripts": "esbuild scripts/migrate.ts scripts/create-admin.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';import{fileURLToPath}from'url';import{dirname}from'path';const require=createRequire(import.meta.url);const __filename=fileURLToPath(import.meta.url);const __dirname=dirname(__filename);\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "smtp-server": "^3.19.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
